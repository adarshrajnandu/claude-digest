# .env.example — local development secrets template.
# Copy to .env and fill in your values.
# NEVER commit .env — it contains secrets. It is already in .gitignore.

# GitHub Personal Access Token (fine-grained, no special scopes needed for public repos).
# Generate at: https://github.com/settings/personal-access-tokens/new
# Choose "Fine-grained token", set expiration, select "All public repositories" (read-only).
# This raises the rate limit from 60 to 5,000 requests/hour.
GITHUB_PAT=ghp_your_token_here

# Anthropic API key for Claude analysis.
# Get or create at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Resend API key for email delivery.
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Comma-separated list of recipient email addresses.
# Example: you@example.com,friend@example.com
# Keep this in secrets only — never commit email addresses to a public repo.
SUBSCRIBER_EMAILS=you@example.com

# Set to 1 to run the full pipeline but skip email delivery (prints HTML preview instead).
# Useful for testing the gather+analyze+render stages locally.
# DRY_RUN=1

# Set to 1 to skip the Anthropic API call and return a mock editorial (tests/fixtures/mock_analysis.txt).
# Use this for template iteration without burning API credits.
# MOCK_LLM=1
