<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Claude Ecosystem Digest — {{ date }}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      color: #1a1a1a;
      background: #f9f9f9;
      margin: 0;
      padding: 0;
    }
    .wrapper {
      max-width: 640px;
      margin: 0 auto;
      background: #ffffff;
    }
    .header {
      background: #2d2d2d;
      padding: 24px 32px;
      text-align: left;
    }
    .header h1 {
      color: #ffffff;
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 4px 0;
      letter-spacing: -0.3px;
    }
    .header .date {
      color: #9ca3af;
      font-size: 13px;
      margin: 0;
    }
    .header .scope-note {
      color: #6b7280;
      font-size: 12px;
      margin: 8px 0 0 0;
    }
    .content {
      padding: 28px 32px 24px;
    }
    .content pre {
      white-space: pre-wrap;
      word-wrap: break-word;
      font-family: inherit;
      font-size: 15px;
      line-height: 1.65;
      margin: 0;
      color: #1a1a1a;
    }
    .footer {
      border-top: 1px solid #e5e7eb;
      padding: 16px 32px;
      color: #9ca3af;
      font-size: 12px;
    }
    .footer a {
      color: #6b7280;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Claude Ecosystem Digest</h1>
      <p class="date">{{ date }}</p>
      <p class="scope-note">GitHub activity only — commits, issues, releases, new repos</p>
    </div>
    <div class="content">
      <pre>{{ body }}</pre>
    </div>
    <div class="footer">
      <p>
        You are receiving this because you are subscribed to the Claude Ecosystem Digest.
        Powered by <a href="https://github.com/anthropics/claude-code">Claude Code</a>.
      </p>
    </div>
  </div>
</body>
</html>
